/ {
	fram: eeprom-emu {
		compatible = "zephyr,emu-eeprom";
		size = <DT_SIZE_K(4)>;
		pagesize = <DT_SIZE_K(8)>;
		partition = <&storage_partition>;
		rambuf;
	};

	counters: sqnano {
		compatible = "zephyr,sqnano";
		path = "counters.db";
		storage = <&fram>;
		page-size = <128>;
		journal-slots = <8>;
	};
};
