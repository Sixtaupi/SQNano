/*
 * The flash simulator shaped as a small NAND: 512-byte pages programmed
 * once each (no double writes), 8 KiB blocks.
 */

&flash_sim0 {
	erase-block-size = <8192>;
	write-block-size = <512>;

	partitions {
		nand_partition: partition@40000 {
			compatible = "zephyr,mapped-partition";
			label = "nand";
			reg = <0x00040000 0x00040000>;
		};
	};
};

/ {
	nanddb: sqnano-nand {
		compatible = "zephyr,sqnano";
		path = "app.db";
		storage = <&nand_partition>;
		nand;
		nand-soft-ecc;
	};
};
