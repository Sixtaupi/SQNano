&flash_sim0 {
	partitions {
		sqnano_partition: partition@41000 {
			compatible = "zephyr,mapped-partition";
			label = "sqnano";
			reg = <0x00041000 0x00040000>;
		};
	};
};

&eeprom0 {
	size = <DT_SIZE_K(64)>;
};

/ {
	flashdb: sqnano-flash {
		compatible = "zephyr,sqnano";
		path = "app.db";
		storage = <&sqnano_partition>;
	};

	framdb: sqnano-fram {
		compatible = "zephyr,sqnano";
		path = "fram.db";
		storage = <&eeprom0>;
		page-size = <256>;
		journal-slots = <12>;
	};
};
